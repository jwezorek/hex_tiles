if(NOT DEFINED HEX_TILES OR NOT DEFINED OUTPUT_ROOT)
    message(FATAL_ERROR "HEX_TILES and OUTPUT_ROOT are required")
endif()
function(run_ok)
    execute_process(COMMAND "${HEX_TILES}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
function(run_bad expected)
    execute_process(COMMAND "${HEX_TILES}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "Expected failure matching '${expected}': ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
run_ok(--help)
run_bad("unknown mode" --mode bogus)
run_bad("requires --preset regular" --mode combinatorial)
run_bad("requires --preset regular" --mode combinatorial --preset golden)
run_bad("custom lengths" --mode combinatorial --long 2 --short 1)
run_bad("cell combinatorial limit" --mode combinatorial --preset regular --depth 4294967295)
foreach(seed yellow blue green purple red)
    foreach(depth 0 1 2 4)
        run_ok(--mode combinatorial --preset regular --seed ${seed} --depth ${depth}
            --arrows --out-dir "${OUTPUT_ROOT}/${seed}-${depth}")
        run_ok(--mode geometric --preset regular --seed ${seed} --depth ${depth}
            --arrows --out-dir "${OUTPUT_ROOT}/reference-${seed}-${depth}")
    endforeach()
endforeach()
run_ok(--mode combinatorial --preset regular --depth 1 --arrows --no-arrows --out-dir "${OUTPUT_ROOT}/no-arrows")
run_ok(--mode geometric --preset regular --depth 1 --out-dir "${OUTPUT_ROOT}/geometric")
run_ok(--preset regular --depth 1 --out-dir "${OUTPUT_ROOT}/default")
run_ok(--preset golden --depth 1 --out-dir "${OUTPUT_ROOT}/golden")
run_ok(--long 3 --short 1 --depth 1 --out-dir "${OUTPUT_ROOT}/custom")
foreach(file patch.svg rules.svg)
    file(READ "${OUTPUT_ROOT}/geometric/${file}" explicit)
    file(READ "${OUTPUT_ROOT}/default/${file}" implicit)
    if(NOT explicit STREQUAL implicit)
        message(FATAL_ERROR "Geometric default changed")
    endif()
    file(READ "${OUTPUT_ROOT}/no-arrows/${file}" svg)
    if(svg MATCHES "arrowhead")
        message(FATAL_ERROR "--no-arrows did not override --arrows")
    endif()
    if(NOT svg MATCHES "<svg xmlns=" OR NOT svg MATCHES "</svg>")
        message(FATAL_ERROR "Missing SVG root")
    endif()
endforeach()
run_bad("--hex-svg requires --mode combinatorial" --hex-svg)
run_ok(--mode combinatorial --preset regular --seed green --depth 4
    --hex-svg --out-dir "${OUTPUT_ROOT}/hex-green-4")
run_ok(--mode combinatorial --preset regular --seed purple --depth 2
    --hex-svg --out-dir "${OUTPUT_ROOT}/hex-purple-2")
run_ok(--mode combinatorial --preset regular --seed red --depth 0
    --hex-svg --out-dir "${OUTPUT_ROOT}/hex-red-0")
foreach(folder hex-green-4 hex-purple-2 hex-red-0)
    if(NOT EXISTS "${OUTPUT_ROOT}/${folder}/hexagons.svg")
        message(FATAL_ERROR "Missing hexagon SVG in ${folder}")
    endif()
endforeach()
